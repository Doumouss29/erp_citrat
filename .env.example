# Identité administrateur initial (à remplacer)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_20_CHARS
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
HTTP_PORT=8088

# Adresse HTTPS publique servant aux liens de récupération.
PUBLIC_URL=https://erp-citrat.158-69-201-110.sslip.io

# Envoi transactionnel SMTP - configurer avant d'activer les inscriptions.
# Sans SMTP_HOST et SMTP_FROM, les inscriptions restent indisponibles.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
