# Identité administrateur initial (à remplacer)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_20_CHARS
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
HTTP_PORT=8088

# Adresse HTTPS publique servant aux liens de récupération.
PUBLIC_URL=https://erp-citrat.158-69-201-110.sslip.io

# Brevo — SMTP transactionnel. Ne jamais committer les identifiants réels.
# Le login SMTP est fourni dans Brevo > SMTP & API (ce n'est pas nécessairement votre e-mail habituel).
# Utiliser une clé SMTP Brevo, pas une clé API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition vérifiée dans Brevo (exemple à remplacer).
SMTP_FROM=
