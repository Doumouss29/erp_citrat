{
  "name": "AccessProfile",
  "properties": {
    "apps": {
      "default": [],
      "description": "Identifiants des applications accordées à ce profil (app_id)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "description": "Courte description du profil",
      "type": "string"
    },
    "name": {
      "description": "Nom affiché du profil / grade",
      "type": "string"
    },
    "order": {
      "default": 0,
      "description": "Ordre d'affichage",
      "type": "number"
    },
    "profile_id": {
      "description": "Identifiant stable du profil (ex: 'agent'), stocké dans User.grade",
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "default": {},
      "description": "Droits explicites par application/module: view, create, edit, delete, export, approve et scope (own|office|department|all). Refus par défaut."
    }
  },
  "required": [
    "profile_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "superviseur"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
