{
  "name": "Attestation",
  "type": "object",
  "properties": {
    "id_lot": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence au lot"
    },
    "id_attributaire": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence \u00e0 l'attributaire"
    },
    "numero_attestation": {
      "type": "string",
      "description": "Num\u00e9ro unique de l'attestation"
    },
    "date_attestation": {
      "type": "string",
      "format": "date",
      "description": "Date de l'attestation"
    },
    "type_attestation": {
      "type": "string",
      "enum": [
        "Attribution",
        "Propri\u00e9t\u00e9",
        "Occupation",
        "Autre"
      ],
      "description": "Type d'attestation"
    },
    "document_url": {
      "type": "string",
      "description": "URL du document g\u00e9n\u00e9r\u00e9"
    },
    "qr_code": {
      "type": "string",
      "description": "Donn\u00e9es du QR code de v\u00e9rification"
    },
    "observations": {
      "type": "string",
      "description": "Observations compl\u00e9mentaires"
    }
  },
  "required": [
    "id_lot",
    "numero_attestation"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "role": "viewer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.consentement_version": "1"
          }
        },
        {
          "$nor": [
            {
              "user_condition": {
                "role": "en_attente"
              }
            },
            {
              "user_condition": {
                "role": "suspendu"
              }
            },
            {
              "user_condition": {
                "data.statut": "suspendu"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
