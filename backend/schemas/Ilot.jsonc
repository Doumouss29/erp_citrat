{
  "name": "Ilot",
  "properties": {
    "couleur": {
      "description": "Couleur d'affichage de l'\u00eelot",
      "type": "string"
    },
    "geometrie": {
      "description": "G\u00e9om\u00e9trie GeoJSON du polygone",
      "type": "object"
    },
    "id_lotissement": {
      "description": "R\u00e9f\u00e9rence au lotissement",
      "type": "string"
    },
    "nombre_lots": {
      "description": "Nombre de lots dans l'\u00eelot",
      "type": "number"
    },
    "numero_ilot": {
      "description": "Num\u00e9ro de l'\u00eelot",
      "type": "string"
    },
    "numero_lot_debut": {
      "description": "Premier num\u00e9ro de lot",
      "type": "string"
    },
    "numero_lot_fin": {
      "description": "Dernier num\u00e9ro de lot",
      "type": "string"
    }
  },
  "required": [
    "id_lotissement",
    "numero_ilot"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.grade": "administration"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "role": "viewer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.consentement_version": "1"
          }
        },
        {
          "$nor": [
            {
              "user_condition": {
                "role": "en_attente"
              }
            },
            {
              "user_condition": {
                "role": "suspendu"
              }
            },
            {
              "user_condition": {
                "data.statut": "suspendu"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.grade": "administration"
          }
        }
      ]
    }
  },
  "type": "object"
}
