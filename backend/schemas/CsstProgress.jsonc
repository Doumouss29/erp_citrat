{
  "name": "CsstProgress",
  "properties": {
    "certificates": {
      "additionalProperties": true,
      "description": "Certificats obtenus par module : { number, date } ou null",
      "type": "object"
    },
    "participant_name": {
      "description": "Nom affich\u00e9 sur les certificats",
      "type": "string"
    },
    "scores": {
      "additionalProperties": true,
      "description": "Meilleur score (%) par module : terrain, route, ergonomie, isole (null = pas encore pass\u00e9)",
      "type": "object"
    },
    "user_email": {
      "description": "E-mail de l'utilisateur (une seule fiche par utilisateur)",
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}