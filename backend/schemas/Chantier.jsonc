{
  "name": "Chantier",
  "properties": {
    "nom": {
      "description": "Nom du chantier",
      "type": "string"
    },
    "surface_ha": {
      "description": "Surface totale en hectares",
      "type": "number"
    }
  },
  "required": [
    "nom"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}