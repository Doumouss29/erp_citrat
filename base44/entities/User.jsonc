    },
    "first_name": {
      "title": "Pr\u00e9nom",
      "type": "string"
    },
    "fonction": {
      "description": "Fonction dans le module CGESN-Board (attribu\u00e9e automatiquement ou par l'administrateur)",
      "enum": [
        "admin",
        "responsable",
        "adjoint",
        "secretaire"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Fonction",
      "type": "string"
    },
    "grade": {
      "description": "profile_id d'un AccessProfile : d\u00e9termine les applications accord\u00e9es automatiquement",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Grade / profil d'acc\u00e8s",
      "type": "string"
    },
    "last_name": {
      "title": "Nom",
      "type": "string"
    },
    "office": {
