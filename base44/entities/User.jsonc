      "type": "boolean"
    },
    "telephone": {
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone (confirm\u00e9 \u00e0 l'\u00e9cran de consentement)",
      "title": "T\u00e9l\u00e9phone",
      "type": "string"
    },
    "demande_acces_date": {
      "type": "string",
      "format": "date-time",
      "title": "Date de demande d\u2019acc\u00e8s au portail",
