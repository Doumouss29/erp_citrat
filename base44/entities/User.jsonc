      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Organisation",
      "type": "string"
    },
    "role": {
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "viewer"
      ],
      "type": "string"
    },
    "statut": {
      "default": "actif",
      "description": "Statut du compte utilisateur",
      "enum": [
        "actif",
        "suspendu"
      ],
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "super_admin": {
      "default": false,
