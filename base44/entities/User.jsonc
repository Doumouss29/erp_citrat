{
  "name": "User",
  "properties": {
    "access": {
      "default": [],
      "description": "Applications accord\u00e9es individuellement, en plus de celles du grade",
      "items": {
        "type": "string"
      },
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Acc\u00e8s suppl\u00e9mentaires",
      "type": "array"
    },
    "armoirie_url": {
      "description": "URL de l'armoirie pour les guides PDF (module E-GUIDE)",
      "type": "string"
    },
    "bureau_code": {
      "description": "Code du bureau principal (d\u00e9termin\u00e9 par assignation admin)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Code bureau",
      "type": "string"
    },
    "bureau_id": {
      "description": "ID du bureau principal (d\u00e9termin\u00e9 par assignation admin ou secr\u00e9tariat)",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Bureau principal",
      "type": "string"
    },
    "bureau_ids": {
      "description": "IDs des bureaux accessibles (d\u00e9termin\u00e9s par assignation admin ou secr\u00e9tariat)",
      "items": {
        "type": "string"
      },
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "Bureaux accessibles",
      "type": "array"
    },
    "consentement_date": {
      "format": "date-time",
      "title": "Date de l'accord",
      "type": "string"
    },
    "consentement_version": {
      "description": "Vide = accord non donn\u00e9 ou retir\u00e9 : l'acc\u00e8s au portail est bloqu\u00e9 tant qu'elle ne correspond pas \u00e0 la version en vigueur",
      "title": "Version de la notice accept\u00e9e",
      "type": "string"
    },
    "copro_profil": {
      "description": "Profil m\u00e9tier dans le module COPROCIV (g\u00e9om\u00e8tre-expert, notaire, syndic, copropri\u00e9taire) \u2014 attribu\u00e9 par l'administrateur uniquement",
      "enum": [
        "geometre",
        "notaire",
        "syndic",
        "coproprietaire"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "title": "Profil COPROCIV",
      "type": "string"
    },
    "date_naissance": {
      "description": "Sert \u00e0 calculer l'\u00e2ge (confirm\u00e9e \u00e0 l'\u00e9cran de consentement)",
      "format": "date",
      "title": "Date de naissance",
      "type": "string"
    },
    "department": {
      "description": "D\u00e9partement de rattachement (m\u00eames valeurs que la fiche employ\u00e9) \u2014 g\u00e9r\u00e9 depuis l'administration du portail",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "title": "D\u00e9partement",
