{
  "name": "JournalCaisse",
  "properties": {
    "action": {
      "description": "Action effectu\u00e9e",
      "enum": [
        "creation",
        "modification",
        "annulation",
        "suppression",
        "validation",
        "rejet"
      ],
      "type": "string"
    },
    "beneficiaire": {
      "description": "B\u00e9n\u00e9ficiaire au moment de l'action",
      "type": "string"
    },
    "bureau_code": {
      "description": "Code du bureau",
      "type": "string"
    },
    "bureau_id": {
      "description": "ID du bureau",
      "type": "string"
    },
    "changements": {
      "description": "Champs modifi\u00e9s",
      "items": {
        "properties": {
          "apres": {
            "type": "string"
          },
          "avant": {
            "type": "string"
          },
          "champ": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "date_action": {
      "description": "Date/heure r\u00e9elle de l'action (renseign\u00e9e pour la reprise de l'historique)",
      "type": "string"
    },
    "montant": {
      "description": "Montant de l'op\u00e9ration au moment de l'action",
      "type": "number"
    },
    "motif": {
      "description": "Motif (annulation, rejet...)",
      "type": "string"
    },
    "numero_bon": {
      "description": "N\u00b0 du bon",
      "type": "string"
    },
    "operation_id": {
      "description": "ID de l'op\u00e9ration de caisse",
      "type": "string"
    },
    "reprise": {
      "description": "Entr\u00e9e reconstitu\u00e9e \u00e0 partir des bons existants avant la mise en place du journal",
      "type": "boolean"
    },
    "type_operation": {
      "description": "entree / sortie / solde_depart",
      "type": "string"
    },
    "user_email": {
      "description": "Email de l'auteur de l'action (v\u00e9rifi\u00e9 c\u00f4t\u00e9 serveur)",
      "type": "string"
    },
    "user_nom": {
      "description": "Nom de l'auteur",
      "type": "string"
    }
  },
  "required": [
    "action",
    "operation_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "journal_verrouille"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "journal_verrouille"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.fonction": "admin"
          }
        },
        {
          "data.bureau_id": "{{user.data.bureau_id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "journal_verrouille"
          }
        }
      ]
    }
  },
  "type": "object"
}