{
  "name": "Notification",
  "properties": {
    "is_read": {
      "default": false,
      "description": "Lu ou non",
      "type": "boolean"
    },
    "message": {
      "description": "Message",
      "type": "string"
    },
    "related_id": {
      "description": "ID de l'\u00e9l\u00e9ment li\u00e9",
      "type": "string"
    },
    "source_id": {
      "description": "ID d'origine dans l'ancien RH-CGESN (migration)",
      "type": "string"
    },
    "title": {
      "description": "Titre",
      "type": "string"
    },
    "type": {
      "default": "general",
      "description": "Type de notification",
      "enum": [
        "leave",
        "absence",
        "mission",
        "general",
        "validation"
      ],
      "type": "string"
    },
    "user_email": {
      "description": "Email du destinataire",
      "type": "string"
    },
    "mail_key": {
      "type": "string",
      "rls": {
        "write": false,
        "create": false,
        "update": false
      }
    },
    "mail_notice": {
      "type": "object",
      "rls": {
        "write": false,
        "create": false,
        "update": false
      }
    },
    "mail_status": {
      "type": "string",
      "rls": {
        "write": false,
        "create": false,
        "update": false
      }
    },
    "mail_attempt_at": {
      "type": "string",
      "rls": {
        "write": false,
        "create": false,
        "update": false
      }
    }
  },
  "required": [
    "user_email",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}
