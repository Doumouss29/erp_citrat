{
  "name": "SecretaireBureau",
  "type": "object",
  "properties": {
    "nom_complet": {
      "type": "string",
      "description": "Nom complet de la secr\u00e9taire"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "email": {
      "type": "string",
      "description": "Adresse email"
    },
    "bureau_ids": {
      "type": "array",
      "description": "IDs des bureaux rattach\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "bureau_codes": {
      "type": "array",
      "description": "Codes des bureaux rattach\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "bureau_noms": {
      "type": "array",
      "description": "Noms des bureaux rattach\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "responsable_noms": {
      "type": "array",
      "description": "Noms des responsables de bureau li\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "responsable_emails": {
      "type": "array",
      "description": "Emails des responsables de bureau li\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "actif": {
      "type": "boolean",
      "default": true,
      "description": "Secr\u00e9taire active dans le syst\u00e8me"
    }
  },
  "required": [
    "nom_complet",
    "telephone",
    "email",
    "bureau_ids"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}