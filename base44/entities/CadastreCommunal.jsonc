{
  "name": "CadastreCommunal",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "ID de l'organisation propri\u00e9taire"
    },
    "commune": {
      "type": "string",
      "description": "Nom de la commune (en majuscules)"
    },
    "nom_section": {
      "type": "string",
      "description": "Nom ou code de la section cadastrale"
    },
    "nombre_parcelles": {
      "type": "number",
      "description": "Nombre de parcelles dans ce fichier"
    },
    "geojson_url": {
      "type": "string",
      "description": "URL du fichier GeoJSON stock\u00e9"
    }
  },
  "required": [
    "organisation_id",
    "commune",
    "nom_section",
    "geojson_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superviseur"
              }
            },
            {
              "$and": [
                {
                  "data.organisation_id": {
                    "$ne": ""
                  }
                },
                {
                  "data.organisation_id": "{{user.data.organisation_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "$and": [
                {
                  "data.organisation_id": {
                    "$ne": ""
                  }
                },
                {
                  "data.organisation_id": "{{user.data.organisation_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
