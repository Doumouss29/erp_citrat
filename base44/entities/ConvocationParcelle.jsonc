{
  "name": "ConvocationParcelle",
  "properties": {
    "commune": {
      "description": "Commune de la parcelle",
      "type": "string"
    },
    "coordX": {
      "description": "Coordonn\u00e9e X de la parcelle",
      "type": "string"
    },
    "coordY": {
      "description": "Coordonn\u00e9e Y de la parcelle",
      "type": "string"
    },
    "ilot": {
      "description": "\u00celot",
      "type": "string"
    },
    "lot": {
      "description": "Lot",
      "type": "string"
    },
    "organisation_id": {
      "description": "ID de l'organisation propri\u00e9taire",
      "type": "string"
    },
    "parcelle": {
      "description": "Num\u00e9ro de parcelle",
      "type": "string"
    },
    "quartier": {
      "description": "Quartier",
      "type": "string"
    },
    "section": {
      "description": "Section cadastrale",
      "type": "string"
    },
    "statut": {
      "default": "active",
      "description": "Statut de la convocation",
      "enum": [
        "active",
        "recensee"
      ],
      "type": "string"
    },
    "surface": {
      "description": "Superficie de la parcelle",
      "type": "number"
    }
  },
  "required": [
    "organisation_id",
    "commune",
    "section",
    "parcelle"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "superviseur"
              }
            },
            {
              "$and": [
                {
                  "data.organisation_id": {
                    "$ne": ""
                  }
                },
                {
                  "data.organisation_id": "{{user.data.organisation_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "$and": [
                {
                  "data.organisation_id": {
                    "$ne": ""
                  }
                },
                {
                  "data.organisation_id": "{{user.data.organisation_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superviseur"
          }
        }
      ]
    }
  },
  "type": "object"
}
