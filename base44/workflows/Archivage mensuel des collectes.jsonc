{
  "name": "Archivage mensuel des collectes",
  "description": "D\u00e9place automatiquement les collectes des mois pr\u00e9c\u00e9dents vers l\u2019historique au d\u00e9but de chaque mois.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "archivage_mensuel_des_collectes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveCollectesMensuelles",
            "args": {
              "limit": 200,
              "maxBatches": 10
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "archiveCollectesMensuelles"
  }
}