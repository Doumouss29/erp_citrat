    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "HSEEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerte_email_nouvelle_fiche_hse",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertNewHSEEvent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
